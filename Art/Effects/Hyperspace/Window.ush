// Green spacetime rupture: layered luminous sheets and sparse torn creases.
// Original procedural field, evaluated at native pixel resolution, no movie texture.
float opening=saturate(Radius);
float2 p=(UV-.5)*6/max(opening,.001);
p.x/=lerp(.42,1.0,smoothstep(.05,.78,opening));
float r=length(p), t=PhaseTime;
float edge=1-smoothstep(2.3,2.9,r);
if(edge<=0 || Strength<=0)return float4(0,0,0,0);
float pixel=max(length(float2(ddx(p.x),ddy(p.y))),.0007);
float3 q=float3(p*3.1,t*.55);
float2 warp=float2(F.Fbm(q+3),F.Fbm(q+17))-.5;
float2 tornP=p+warp*.48;
float coreR=length(tornP*float2(1.0,.92));
float n=F.Fbm(float3(tornP*6,t*.48));
float fine=F.Noise(float3(p*47,t*.8));
float lips=0, sheets=0, scatter=0;
[unroll] for(int i=0;i<21;++i)
{
    float id=i+1;
    float seed=F.Hash(float3(id,11,6));
    float seed2=F.Hash(float3(id,29,7));
    float angle=id*2.399963+.7*(seed-.5);
    float2 axis=float2(cos(angle),sin(angle)),side=float2(-axis.y,axis.x);
    float x=dot(tornP,axis), y=dot(tornP,side);
    float extent=lerp(.62,1.86,seed);
    float along=saturate((x-.15)/(extent-.15));
    float bend=(F.Noise(float3(x*4.3,id*3.7,t*.48))-.5)*.37;
    bend+=(seed2-.5)*x*x*.17;
    float torn=(F.Noise(float3(x*23,id*5,t*.8))-.5)*.033;
    float width=(.07+.28*seed2)*pow(1-along,1.2);
    width*=.45+.55*smoothstep(seed*.28,.65+seed*.3,opening);
    float growth=lerp(.35,1,smoothstep(seed*.22,.7+seed*.25,opening));
    float gate=smoothstep(.07,.3,x)*(1-smoothstep(extent*growth-.14,extent*growth,x));
    float d=y-bend-torn;
    float lip=exp(-pow(abs(d-width*.3)/max(width*.045+pixel,.002),1.3));
    float sheet=exp(-pow(abs(d+width*.5)/max(width*1.1,.002),1.5));
    float tipFade=pow(1-along,1.3);
    float striation=F.Fbm(float3(x*8,d*32+id*2,t*.65));
    float breaks=smoothstep(.28,.70,striation);
    float strength=i<8?1.0:.48;
    lips+=lip*gate*tipFade*(.25+seed)*breaks*strength;
    sheets+=sheet*gate*tipFade*(.3+.5*seed2)*striation*strength;
    scatter+=exp(-abs(d)/(.06+width))*gate*tipFade*.12*breaks;
}
// Integrate six displaced depth layers. Density is anisotropic and broken into
// fine folded sheets; dark gaps survive outside the luminous entry core.
float volume=0;
[unroll] for(int layer=0;layer<6;++layer)
{
    float z=layer*.23;
    float3 v=float3(tornP*(3.7+z*.4)+float2(z*.09,-z*.11),z-t*.46);
    float f=F.Fbm(v);
    float ridge=pow(saturate(1-abs(f*2.6-1.22)),4);
    float envelope=exp(-coreR*coreR*(3.6+z));
    volume+=ridge*envelope*(.6+f)*.24;
}
float core=exp(-coreR*coreR*12)*(3.8+1.8*n);
float cloud=volume*(.65+.35*fine);
float3 mint=float3(.55,1.0,.73), jade=float3(.10,.54,.32);
float3 c=mint*(core+cloud*2.0+lips*1.8)+jade*(sheets*3.2+scatter*.8);
// Broad density is translucent; the central aperture alone fully occludes hull.
float coreMask=1-smoothstep(.27,.53+.10*(n-.5),coreR);
float opacity=max(coreMask,saturate(volume*.8+sheets*1.5+lips*.28+scatter*.18));
return float4(c*Strength,opacity*edge*saturate(Strength*2));
